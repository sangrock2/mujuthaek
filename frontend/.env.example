# 백엔드 api 주소 — 로컬 개발 전용. 브라우저가 백엔드를 바로 불러요 (Vercel에서는 넣지 않아요: 같은 주소로 부르고 Vercel이 넘겨요)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 백엔드 주소 — 서버 전용(브라우저로 안 나감), Vercel에서 환경별로 설정 (Production http://3.37.131.73 · Preview http://52.79.106.144).
# 있으면 /api/**·/oauth2/**·/login/oauth2/**를 이 주소로 넘겨요(next.config.ts rewrites). 로컬은 비워 둬요
# API_ORIGIN=
# 웹 푸시 VAPID 공개 키 (pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 목업 대신 실제 API를 부를 때 false (기본은 목업)
NEXT_PUBLIC_USE_MOCKS=true
# 카카오맵 JavaScript 키 (카카오 개발자 콘솔 > 앱 키 > JavaScript 키, 플랫폼 > Web에 사이트 도메인 등록)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Google Analytics 4 측정 ID (G-…). 비우면 GA를 쓰지 않아요. 운영·개발 속성 ID를 따로 넣어요
NEXT_PUBLIC_GA_ID=
# 1이면 GA 이벤트가 DebugView에만 보여요(개발 확인용)
NEXT_PUBLIC_GA_DEBUG=

# 화면 요청 기록(서버 전용, 브라우저로 안 나감): 화면만 긁는 봇을 관리자 「트래픽」에서 보려고 api로 넘겨요. 비우면 안 넘겨요
# TRAFFIC_INGEST_URL=http://localhost:8080
# TRAFFIC_INGEST_TOKEN=api의 TRAFFIC_INGEST_TOKEN과 같은 값
