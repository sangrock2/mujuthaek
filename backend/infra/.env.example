# 복사해서 쓰세요: cp infra/.env.example infra/.env (.env는 git에 올리지 않아요). make infra가 없으면 자동으로 복사해요
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-pass
API_DB_PASSWORD=api-pass
COLLECTOR_DB_PASSWORD=collector-pass
# 처음 수집 개수 제한: 배포 뒤 처음 한 번 묶음마다 최신 몇 개만 AI 추출로 보낼지 (그 이전 글은 쓰지 않아요, services/collector/README.md)
# 비우면 기본값: LH 주거 10 · 다른 주거 10 · 사업공간 10 · 지원 정책 500
# COLLECTOR_INTAKE_HOUSING_LH=10
# COLLECTOR_INTAKE_HOUSING_OTHER=10
# COLLECTOR_INTAKE_SPACE=10
# COLLECTOR_INTAKE_POLICY=500
EXTRACTION_DB_PASSWORD=extraction-pass
NOTIFICATION_DB_PASSWORD=notification-pass

RABBITMQ_USER=mujuthaek
RABBITMQ_PASSWORD=mq-pass

# 원본 파일 저장소 (로컬 MinIO). collector의 기본값(S3_ENDPOINT=http://localhost:9000, minio / minio-pass)과 같아요
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-pass
S3_BUCKET=mujuthaek-raw

# 정책 API 인증키 (collector). 비우면 그 출처는 수집하지 않고 FAILED로 남아요
# 공공데이터포털: 보조금24(15113968)·중앙부처복지(15090532)·지자체복지(15108347)를 각각 활용신청해요
DATA_GO_KR_SERVICE_KEY=
# 온통청년: youthcenter.go.kr 마이페이지에서 발급
YOUTHCENTER_API_KEY=
# K-Startup(창업진흥원_K-Startup 조회서비스)은 공공데이터포털 키(DATA_GO_KR_SERVICE_KEY)를 같이 써요. 활용신청만 따로 해요
# 기업마당: bizinfo.go.kr 정책정보 개방 API에서 발급
BIZINFO_API_KEY=

# extraction 모델. 로컬 AI(LOCAL_AI_URL)를 먼저 쓰고, 안 되면 유료 OpenAI API를 써요
# LOCAL_AI_URL을 비우면 OpenAI API를 바로 쓰고, OPENAI_API_KEY를 비우면 로컬 AI만 써요(둘 다 없으면 추출 실패로 남아요)
LOCAL_AI_URL=
OPENAI_API_KEY=
# 월 유료 AI 비용이 상한(EXTRACTION_MONTHLY_BUDGET_USD, 기본 $600)의 80%를 넘으면 달마다 한 번 보낼 슬랙 수신 웹훅 주소. 비우면 로그만 남겨요
# 비우면 아래 공통 SLACK_WEBHOOK_URL을 써요
EXTRACTION_SLACK_WEBHOOK_URL=
# 파이썬 워커 공통 슬랙 수신 웹훅 주소 (libs/python-platform mujuthaek_platform.slack). 비우면 알림 없이 경고 로그만 한 번 남겨요
SLACK_WEBHOOK_URL=

# LH 수집기: 공공데이터포털 인증키 (LH 분양임대공고문·상세정보·공급정보, 마이홈 모집공고 API 활용신청). 포털에 보이는 키를 그대로 (인코딩된 값도 돼요). 비우면 LH 수집만 멈춰요
LH_API_KEY=

# api 카카오 로그인: developers.kakao.com > 내 애플리케이션 > 앱 키의 REST API 키, 카카오 로그인 > 보안의 Client Secret
# Redirect URI는 http://localhost:8080/login/oauth2/code/kakao 를 등록해요. 비우면 로그인만 동작하지 않아요
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# api 네이버 로그인: developers.naver.com > Application > 네이버 로그인, 제공 정보는 '별명'만.
# Callback URL은 http://localhost:8080/login/oauth2/code/naver. 개발 중에는 '멤버 관리'에 등록한 아이디만 로그인돼요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# api 구글 로그인: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션).
# 승인된 리디렉션 URI는 http://localhost:8080/login/oauth2/code/google. 테스트 중에는 동의 화면의 '테스트 사용자'만 로그인돼요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인 뒤 돌아갈 프론트 주소 (CORS 허용 주소)
FRONTEND_URL=http://localhost:3000
# access token(JWT) 서명 키. 32바이트 이상 무작위 값 (예: openssl rand -base64 48). 운영은 필수.
# 로컬은 이 줄을 주석으로 두면 기본값을 써요 (빈 값 'JWT_SECRET='으로 두면 서버가 뜨지 않아요)
# JWT_SECRET=
# 처음 최상위 관리자로 정할 회원 ID. 관리자로 쓸 계정으로 가입한 뒤 /api/users/me의 id를 넣고 api를 다시 띄워요.
# 최상위가 이미 있으면 무시해요 (그 뒤로는 관리자 화면 「회원」에서 넘기기). 처음 가입한 사람을 자동으로 올리지는 않아요
ADMIN_BOOTSTRAP_USER_ID=

# 웹 푸시 VAPID 키 한 쌍: npx web-push generate-vapid-keys 로 한 번 만들어요. 공개키는 api·알림 서버, 개인키는 알림 서버만 써요
# 비우면 api가 구독을 받지 않아요. 키를 바꾸면 모든 구독이 무효가 돼요. 개인키는 커밋하지 말고 .env·배포 비밀값에만 둬요
PUSH_VAPID_PUBLIC_KEY=

# area 좌표 찾기: 도로명주소 개발자센터(business.juso.go.kr) 검색 API 승인키. 비우면 주소 사전으로만 찾아요 (api가 읽어요)
JUSO_SEARCH_API_KEY=
# area 새 건물 좌표: 도로명주소 개발자센터 좌표제공 API 승인키 (검색 API와 다른 키). 비우면 법정동 대표점으로 (api가 읽어요)
JUSO_COORD_API_KEY=

# 알림 서버 웹 푸시: log(보내지 않고 로그만, 기본) 또는 webpush(푸시 서비스로 보내기)
# webpush면 VAPID 키 한 쌍이 있어야 서버가 떠요 (공개키는 api의 PUSH_VAPID_PUBLIC_KEY와 같은 값). 개인키는 커밋하지 말고 .env·배포 비밀값에만
NOTIFICATION_PUSH_PROVIDER=log
# PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스(FCM·Mozilla·Apple) 운영자가 문제 있을 때 연락할 곳. 메일을 보내는 설정이 아니에요. mailto: 또는 https: (서비스 주소면 돼요)
# 비우면 mailto:noreply@localhost (로컬은 그대로 둬도 돼요). 배포는 실제 서비스 주소로
# PUSH_VAPID_SUBJECT=https://example.com
