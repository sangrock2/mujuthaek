# tools/perf/.env 로 복사해서 채워요 (tools/perf/.env는 커밋되지 않아요)
# 서버 주소는 저장소에 적지 않아요. 아래 203.0.113.10은 문서용 예시 주소(RFC 5737)예요 (2026-11-16 보안 감사 4장)

BASE_URL=                            # k6가 부르는 곳(예: http://203.0.113.10). Vercel을 거치지 않고 EC2 nginx로 바로
EC2_HOST=                            # SSH로 붙을 서버(예: 203.0.113.10)
SSH_USER=ubuntu
SSH_KEY=                             # 예: ~/.ssh/<서버 키>.pem

# CloudWatch 그래프·숫자 저장용 (aws cli 로그인이 돼 있어야 해요. 비우면 그 단계만 건너뛰어요)
AWS_REGION=ap-northeast-2
AWS_PROFILE=
EC2_INSTANCE_ID=                     # i-…
RDS_INSTANCE_ID=                     # RDS 식별자

# 로그인 사용자 흐름(15%). 둘 다 비우면 그 몫은 판정 흐름으로 돌려요 (meta.json에 남아요)
# 토큰은 로컬·스테이징 api(localhost, *.localhost, *.test, staging.·dev.·test.·qa. 로 시작하는 주소)에만 만들어요.
# 운영 JWT_SECRET은 노트북에 두지 않아요: 그 값이면 어느 회원·관리자 토큰이든 만들 수 있어요. BASE_URL이 운영이면 run.sh·k6가 멈춰요
JWT_SECRET=                          # 로컬·스테이징 api의 JWT_SECRET만
TEST_USER_ID=                        # 테스트 계정 회원 id (UUID)
# 서버 .env의 METRICS_TOKEN과 같은 값. 운영 지표(/actuator/prometheus)를 읽을 때만 필요해요
METRICS_TOKEN=
